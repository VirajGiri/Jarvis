{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "J.A.R.V.I.S. 24/7 multi-agent Windows AI platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "tsx": "^4.19.2",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3"
  }
}
